rules_version = '2';

// Paste in Firebase Console > Firestore Database > Rules > Publish.
// OWNER_EMAIL below must equal OWNER_EMAIL in index.html.
// All other accounts are managed in the app: Settings > Registered users (admin, user, biller).
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    // The owner account is always an admin
    function isOwner() {
      return signedIn() && request.auth.token.email == 'mickelp.panigua@gmail.com';
    }

    // Registered-users list in hub/access: { admins: [...], users: [...], billers: [...] }
    function listed(field) {
      return request.auth.token.email in get(/databases/$(database)/documents/hub/access).data.get(field, []);
    }

    function isAdmin()  { return isOwner() || (signedIn() && listed('admins')); }
    // Staff: results, feedback, directory, lab results and settings (not billing)
    function isStaff()  { return isAdmin() || (signedIn() && listed('users')); }
    // Billers: billing only
    function isBiller() { return isAdmin() || (signedIn() && listed('billers')); }
    // Any registered account
    function isListed() { return isStaff() || isBiller(); }

    // Registered users: any registered account can read the list; only admins can change it
    match /hub/access {
      allow read: if isListed();
      allow write: if isAdmin();
    }

    // Working data: results, directory, personnel, holidays, TAT and package settings
    match /hub/state {
      allow read, write: if isStaff();
    }

    // Feedback ratings and forms received: admins only
    match /hub/admin {
      allow read, write: if isAdmin();
    }

    // Lab results and significant findings
    match /labs/{labId} {
      allow read, write: if isStaff();
    }

    // Activity log: any registered account can add entries; only admins can read them
    match /audit/{entryId} {
      allow read: if isAdmin();
      allow create: if isListed();
      allow update, delete: if false;
    }

    // APE companies for linking billing (name, address, payment mode, HMO contact). Staff write; billers read.
    match /billing_refs/{docId} {
      allow read: if isBiller();
      allow write: if isStaff();
    }

    // Billing settings: letterhead, provider list, packages, signatures. Billers read; admins change.
    match /billing_settings/{docId} {
      allow read: if isBiller();
      allow write: if isAdmin();
    }

    // Billing companies (rosters and billing runs). Billers can edit everything except prices;
    // admins can change prices and delete companies.
    match /billing_companies/{coId} {
      allow read, create: if isBiller();
      allow update: if isAdmin() ||
        (isBiller() && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['prices']));
      allow delete: if isAdmin();

      // Archived statements
      match /archive/{archId} {
        allow read, create, update: if isBiller();
        allow delete: if isAdmin();
      }
    }
  }
}
